# Template for .env — copy it, fill in the values. .env is never versioned.

# Keys of the model providers. They stay with the orchestrator; none of them reaches the sandboxes.
DEEPSEEK_API_KEY=sk-...

# Login to the API: token (default, AGW_API_TOKEN) or oidc (through the platform's Keycloak).
# AGW_AUTH_MODE=token

# API token (at least 32 characters; not needed in oidc mode). The web UI logs in once via
# http://127.0.0.1:18480/login?token=<token>; ./dev.sh start shows the link.
AGW_API_TOKEN=

# Credentials of the Compose services (any long random values, e.g. `openssl rand -hex 20`)
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Optional, shown with their default values
# AGW_DEFAULT_MODEL=deepseek/deepseek-flash
# AGW_TOOLSETS=cli                  # bindings of every new chat: cli, mcp, api, any combination (e.g. cli,api)
# AGW_POOL_SIZE=4                   # warm slots for that combination (compose.yaml of this repo: 2)
# AGW_IDLE_TIMEOUT=10m
# AGW_INTERNET_DEFAULT=false        # agents request internet via approval
# AGW_AUTO_COMPACT_DEFAULT=true
# AGW_COMPACT_RESERVE_TOKENS=16384  # auto-compaction from window minus this value
# AGW_COMPACT_KEEP_RECENT_TOKENS=20000
# AGW_APPROVAL_TIMEOUT=10m
# AGW_ARTIFACT_MAX_MB=50
# AGW_IMAGE_MAX_MB=10   # display images in replies (PNG, JPEG, GIF, WebP)
# AGW_WORKSPACE_MAX_MB=200   # back up /workspace per chat (survives idling); 0 = off
# AGW_BG_MAX=5                 # concurrent background tasks (bash with run_in_background) per slot
# AGW_BG_WAKES_PER_HOUR=10     # how often per chat and hour the end of a background task may wake the agent; 0 = never
# AGW_AUTO_TURNS_MAX=5         # at most this many consecutive turns without the user (wake-ups) per chat; 0 = none
# AGW_BG_KEEPALIVE=1h          # running background tasks postpone idling for at most this long; 0 = not at all
# AGW_SANDBOX_MEMORY_MB=2048
# AGW_SANDBOX_CPUS=1
# AGW_HTTP_PORT=18480
# AGW_ALLOWED_HOSTS=127.0.0.1:18480,localhost:18480
# AGW_PG_PORT=18482
# AGW_S3_CONSOLE_PORT=18483

# Secret key of our own SearXNG (created by ./dev.sh)
SEARXNG_SECRET=

# Agri-Gaia platform (direct binding; off without AGW_PLATFORM_API_URL). The account logs in with a
# password grant through the Keycloak client "frontend"; token and password stay in the orchestrator.
# AGW_PLATFORM_API_URL=https://api.agri-gaia.localhost
# AGW_PLATFORM_TOKEN_URL=https://keycloak.agri-gaia.localhost/realms/test-realm/protocol/openid-connect/token
# AGW_PLATFORM_CLIENT_ID=frontend
# AGW_PLATFORM_USER=
# AGW_PLATFORM_PASSWORD=
# Token exchange per chat (RFC 8693): confidential client with token exchange and audience mappers
# (setup in keycloak-token-austausch.md in the thesis repo, section "Client agw-agent für den PoC").
# AGW_PLATFORM_CLIENT_ID=agw-agent
# AGW_PLATFORM_CLIENT_SECRET=
# AGW_PLATFORM_TOKEN_EXCHANGE=true
# AGW_PLATFORM_AUDIENCES=backend,minio

# Login through the platform (AGW_AUTH_MODE=oidc). Client agw-agent: Standard Flow on,
# redirect URI <AGW_PUBLIC_URL>/oidc/callback, Web Origins: origin of <AGW_PUBLIC_URL> (without path).
# AGW_AUTH_MODE=oidc
# AGW_OIDC_ISSUER=https://keycloak.agri-gaia.localhost/realms/test-realm
# AGW_OIDC_CLIENT_ID=agw-agent
# AGW_OIDC_CLIENT_SECRET=           # default: AGW_PLATFORM_CLIENT_SECRET
# AGW_PUBLIC_URL=https://agent.agri-gaia.localhost
# or under a path prefix on the platform's host (Traefik strips /agent with stripprefix):
# AGW_PUBLIC_URL=https://app.agri-gaia.localhost/agent   and   AGW_FRAME_ANCESTORS='self'
# AGW_FRAME_ANCESTORS=https://app.agri-gaia.localhost   # space-separated; empty: embedding forbidden
# AGW_ALLOWED_HOSTS=...             # the host of AGW_PUBLIC_URL is added automatically
# With oidc the orchestrator exchanges the owner's token per chat (AGW_PLATFORM_USER/PASSWORD are not needed):
# AGW_PLATFORM_TOKEN_EXCHANGE=true
