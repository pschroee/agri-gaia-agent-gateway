# Vorlage für poc/.env — kopieren, Werte eintragen. .env wird nie versioniert.

# Schlüssel der Modellanbieter. Sie bleiben beim Orchestrator; in die Sandboxen gelangt keiner.
DEEPSEEK_API_KEY=sk-...

# Token der API (mind. 32 Zeichen). Die Web-UI meldet sich einmal über
# http://127.0.0.1:18480/login?token=<Token> an; ./dev.sh start zeigt den Link.
AGW_API_TOKEN=

# Zugangsdaten der Compose-Dienste (beliebige lange Zufallswerte, etwa `openssl rand -hex 20`)
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Optional, hier mit den Standardwerten
# AGW_DEFAULT_MODEL=deepseek/deepseek-flash
# AGW_POOL_SIZE_CLI=1
# AGW_POOL_SIZE_MCP=1
# AGW_POOL_SIZE_BEIDE=0
# AGW_POOL_SIZE_API=0
# AGW_IDLE_TIMEOUT=10m
# AGW_INTERNET_DEFAULT=false        # Agenten erbitten Internet per Bestätigung
# AGW_AUTO_COMPACT_DEFAULT=true
# AGW_COMPACT_RESERVE_TOKENS=16384  # Auto-Kompaktierung ab Fenster minus diesem Wert
# AGW_COMPACT_KEEP_RECENT_TOKENS=20000
# AGW_APPROVAL_TIMEOUT=10m
# AGW_ARTIFACT_MAX_MB=50
# AGW_IMAGE_MAX_MB=10   # Anzeige-Bilder in Antworten (PNG, JPEG, GIF, WebP)
# AGW_WORKSPACE_MAX_MB=200   # /workspace je Chat sichern (übersteht das Ruhen); 0 = aus
# AGW_BG_MAX=5                 # Hintergrundaufgaben (bash mit run_in_background) je Platz gleichzeitig
# AGW_BG_WAKES_PER_HOUR=10     # so oft darf das Ende einer Hintergrundaufgabe je Chat und Stunde den Agenten wecken; 0 = nie
# AGW_AUTO_TURNS_MAX=5         # höchstens so viele Durchgänge ohne Nutzer (Weckrufe) hintereinander je Chat; 0 = keiner
# AGW_BG_KEEPALIVE=1h          # laufende Hintergrundaufgaben verschieben das Ruhen im Leerlauf höchstens so lange; 0 = gar nicht
# AGW_SANDBOX_MEMORY_MB=2048
# AGW_SANDBOX_CPUS=1
# AGW_HTTP_PORT=18480
# AGW_ALLOWED_HOSTS=127.0.0.1:18480,localhost:18480
# AGW_PG_PORT=18482
# AGW_S3_CONSOLE_PORT=18483

# Geheimschlüssel des eigenen SearXNG (legt ./dev.sh an)
SEARXNG_SECRET=

# Agri-Gaia-Plattform (direkte Anbindung; ohne AGW_PLATFORM_API_URL aus). Das Konto meldet sich per
# Passwort-Grant über den Keycloak-Client „frontend“ an; Token und Passwort bleiben im Orchestrator.
# AGW_PLATFORM_API_URL=https://api.agri-gaia.localhost
# AGW_PLATFORM_TOKEN_URL=https://keycloak.agri-gaia.localhost/realms/test-realm/protocol/openid-connect/token
# AGW_PLATFORM_CLIENT_ID=frontend
# AGW_PLATFORM_USER=
# AGW_PLATFORM_PASSWORD=
# Token-Austausch je Chat (RFC 8693): vertraulicher Client mit Token-Austausch und Audience-Mappern
# (Einrichtung in ../docs/keycloak-token-austausch.md, Abschnitt „Client agw-agent für den PoC“).
# AGW_PLATFORM_CLIENT_ID=agw-agent
# AGW_PLATFORM_CLIENT_SECRET=
# AGW_PLATFORM_TOKEN_EXCHANGE=true
# AGW_PLATFORM_AUDIENCES=backend,minio
